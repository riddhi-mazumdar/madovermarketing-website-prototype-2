{
  "manifest_version": 3,
  "name": "MOM Lens — Mad Over Marketing",
  "version": "0.1.0",
  "description": "A prototype browser layer that turns any webpage into a marketing teardown.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "MOM Lens",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["lens.css"],
      "run_at": "document_idle"
    }
  ]
}